# Copy to .env.local for local dev, and set the same keys in Vercel →
# Project → Settings → Environment Variables.
#
# Only VITE_-prefixed variables reach the browser. Never put a service-role
# key in here — it bypasses every row-level security policy.

# The canonical public URL, no trailing slash. Anything shareable — invite
# links especially — is built from this rather than from window.location, so a
# Vercel preview deploy never hands someone a preview URL to send their friends.
VITE_SITE_URL=https://hellolooseleaf.com

# "demo"     → runs entirely on the built-in demo campus (no network calls)
# "supabase" → reads and writes through Supabase (requires the two keys below)
VITE_DATA_MODE=demo

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# How many digits are in an emailed sign-in code. Supabase decides this
# (Authentication → Email provider settings); its default is not consistent
# across projects — some send 6, some send 8. Set this to match what your
# project actually sends. Defaults to 8. Anything from 6 to 10 is accepted.
VITE_OTP_LENGTH=8

# ── Loose Leaf for Partners ──────────────────────────────────────────────────
#
# There is no Stripe key in this file, and that isn't an omission. Partner
# billing uses Stripe-hosted Checkout and Stripe's billing portal, so the
# browser never holds a Stripe key of any kind — not even a publishable one.
# The secret key lives in the Supabase Edge Function environment instead:
#
#   cp supabase/functions/.env.example supabase/functions/.env
#   supabase secrets set --env-file supabase/functions/.env
#
# The partner platform is live-mode only. With VITE_DATA_MODE=demo the
# /partners marketing pages still render, and everything past "Become a
# Partner" says so rather than simulating a signup that takes card details.
#
# See docs/PARTNERS.md for the full setup order.
