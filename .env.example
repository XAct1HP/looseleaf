# Copy to .env.local for local dev, and set the same keys in Vercel →
# Project → Settings → Environment Variables.
#
# Only VITE_-prefixed variables reach the browser. Never put a service-role
# key in here — it bypasses every row-level security policy.

# "demo"     → runs entirely on the built-in demo campus (no network calls)
# "supabase" → reads and writes through Supabase (requires the two keys below)
VITE_DATA_MODE=demo

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# How many digits are in an emailed sign-in code. Supabase decides this
# (Authentication → Email provider settings); its default is not consistent
# across projects — some send 6, some send 8. Set this to match what your
# project actually sends. Defaults to 8. Anything from 6 to 10 is accepted.
VITE_OTP_LENGTH=8
