# Secrets for the partner billing functions. Never commit the filled-in copy.
#
#   cp .env.example .env
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform — do not set them here.

# Stripe → Developers → API keys. The *secret* key. This never reaches a browser.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → your endpoint → Signing secret.
# This is the endpoint's whsec_…, not the one `stripe listen` prints locally.
STRIPE_WEBHOOK_SECRET=

# Where Stripe is allowed to send partners back to, comma-separated. A target
# whose origin isn't listed is replaced with the first entry, so production
# stays the default. Add your dev origin here or a localhost card test will
# silently land you on the live site.
#   PARTNER_SITE_URL=https://hellolooseleaf.com,http://localhost:5173
PARTNER_SITE_URL=https://hellolooseleaf.com

# Guards `partner-meter-redemptions`, which is the job that tells Stripe what
# to bill for. A long random string; the scheduler sends it as the
# x-worker-token header. Without it the function refuses to run at all, so a
# missing value shows up as "nothing was ever invoiced" rather than as an error
# anybody sees — worth checking first if a month bills nobody.
METER_WORKER_TOKEN=
